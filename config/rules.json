{
  "rules": [
    {
      "id": "INTERNAL_PASSWORD_SPRAY",
      "name": "Internal Password Spray",
      "enabled": true,
      "severity": "High",
      "category": "credential_access",
      "mitreTechnique": "T1110.003",
      "eventIds": [4625],
      "windowMinutes": 5,
      "minEventCount": 20,
      "minDistinctUsernames": 5,
      "cooldownMinutes": 15,
      "description": "Single source failed logons against many usernames on one destination within 5 minutes."
    },
    {
      "id": "DISTRIBUTED_PASSWORD_SPRAY",
      "name": "Distributed Password Spray",
      "enabled": true,
      "severity": "Critical",
      "category": "credential_access",
      "mitreTechnique": "T1110.003",
      "eventIds": [4625],
      "windowMinutes": 10,
      "minEventCount": 50,
      "minDistinctSources": 3,
      "cooldownMinutes": 15,
      "description": "Multiple sources generating high volume of failed logons against one destination."
    },
    {
      "id": "BRUTE_FORCE_SINGLE_ACCOUNT",
      "name": "Brute Force Single Account",
      "enabled": true,
      "severity": "High",
      "category": "credential_access",
      "mitreTechnique": "T1110.001",
      "eventIds": [4625],
      "windowMinutes": 5,
      "minEventCount": 20,
      "maxDistinctUsernames": 1,
      "cooldownMinutes": 10,
      "description": "Single source repeatedly failing one username on one destination."
    },
    {
      "id": "SPRAY_THEN_SUCCESS",
      "name": "Spray Then Success",
      "enabled": true,
      "severity": "Critical",
      "category": "credential_access",
      "mitreTechnique": "T1110.003",
      "type": "sequence",
      "windowMinutes": 15,
      "failureEventId": 4625,
      "successEventId": 4624,
      "minFailures": 5,
      "matchFields": ["SourceIp", "Username"],
      "cooldownMinutes": 30,
      "description": "Multiple failures followed by a successful logon for the same source/username."
    },
    {
      "id": "PRIVILEGED_LOGON_AFTER_FAILURES",
      "name": "Privileged Logon After Failures",
      "enabled": true,
      "severity": "Critical",
      "category": "privilege_escalation",
      "mitreTechnique": "T1078",
      "type": "sequence",
      "windowMinutes": 15,
      "failureEventId": 4625,
      "successEventId": 4624,
      "privilegeEventId": 4672,
      "minFailures": 3,
      "matchFields": ["SourceIp"],
      "cooldownMinutes": 30,
      "description": "Failed logons from a source followed by successful logon and special privileges (4672)."
    },
    {
      "id": "SUSPICIOUS_ACCOUNT_NAMES",
      "name": "Suspicious Account Names",
      "enabled": true,
      "severity": "Medium",
      "category": "credential_access",
      "mitreTechnique": "T1110",
      "eventIds": [4625, 4624],
      "windowMinutes": 10,
      "minEventCount": 5,
      "suspiciousUsernames": [
        "123", "admin", "admin1", "administrator", "guest", "root",
        "www", "wwwroot", "db", "web", "data", "test", "oracle", "postgres"
      ],
      "cooldownMinutes": 20,
      "description": "Suspicious account names with sufficient volume (name alone does not alert)."
    },
    {
      "id": "MULTIPLE_INTERNAL_TARGETS",
      "name": "Multiple Internal Targets",
      "enabled": true,
      "severity": "High",
      "category": "lateral_movement",
      "mitreTechnique": "T1021",
      "type": "network",
      "windowMinutes": 10,
      "minDistinctDestinations": 5,
      "authPorts": [22, 23, 80, 135, 139, 443, 445, 1433, 3306, 3389, 5985, 5986],
      "cooldownMinutes": 15,
      "description": "One source connecting to many destinations on authentication-related ports (possible pivot/scan)."
    },
    {
      "id": "EXPLICIT_CREDENTIALS_LATERAL",
      "name": "Explicit Credentials Lateral Use",
      "enabled": true,
      "severity": "High",
      "category": "lateral_movement",
      "mitreTechnique": "T1021",
      "type": "presence",
      "eventIds": [4648],
      "windowMinutes": 15,
      "minEventCount": 3,
      "cooldownMinutes": 20,
      "description": "Repeated explicit credential logons (4648) often used for lateral movement (runas / remote tools)."
    },
    {
      "id": "NETWORK_LOGON_BURST",
      "name": "Network Logon Burst",
      "enabled": true,
      "severity": "Medium",
      "category": "lateral_movement",
      "mitreTechnique": "T1021.002",
      "eventIds": [4624],
      "logonTypes": [3],
      "windowMinutes": 10,
      "minEventCount": 15,
      "minDistinctSources": 1,
      "cooldownMinutes": 20,
      "description": "Burst of successful network logons (type 3) — possible SMB/WinRM lateral activity."
    },
    {
      "id": "RDP_LOGON_BURST",
      "name": "RDP Logon Burst",
      "enabled": true,
      "severity": "High",
      "category": "lateral_movement",
      "mitreTechnique": "T1021.001",
      "eventIds": [4624, 4625],
      "logonTypes": [10, 7],
      "windowMinutes": 10,
      "minEventCount": 10,
      "cooldownMinutes": 15,
      "description": "Burst of RDP-related logons (type 10/7) from same source."
    },
    {
      "id": "NEW_SERVICE_INSTALLED",
      "name": "New Service Installed",
      "enabled": true,
      "severity": "High",
      "category": "persistence",
      "mitreTechnique": "T1543.003",
      "type": "presence",
      "eventIds": [4697, 7045],
      "windowMinutes": 30,
      "minEventCount": 1,
      "cooldownMinutes": 30,
      "description": "New Windows service installation (4697/7045) — persistence or malware drop."
    },
    {
      "id": "SCHEDULED_TASK_CREATED",
      "name": "Scheduled Task Created",
      "enabled": true,
      "severity": "High",
      "category": "persistence",
      "mitreTechnique": "T1053.005",
      "type": "presence",
      "eventIds": [4698],
      "windowMinutes": 30,
      "minEventCount": 1,
      "cooldownMinutes": 30,
      "description": "New scheduled task (4698) — persistence / lateral execution."
    },
    {
      "id": "ACCOUNT_CREATED",
      "name": "User Account Created",
      "enabled": true,
      "severity": "High",
      "category": "persistence",
      "mitreTechnique": "T1136.001",
      "type": "presence",
      "eventIds": [4720],
      "windowMinutes": 60,
      "minEventCount": 1,
      "cooldownMinutes": 30,
      "description": "Local user account created (4720)."
    },
    {
      "id": "PRIVILEGED_GROUP_CHANGE",
      "name": "Privileged Group Membership Change",
      "enabled": true,
      "severity": "Critical",
      "category": "privilege_escalation",
      "mitreTechnique": "T1098",
      "type": "presence",
      "eventIds": [4728, 4732],
      "windowMinutes": 60,
      "minEventCount": 1,
      "cooldownMinutes": 15,
      "description": "User added to privileged/local group (4728/4732)."
    },
    {
      "id": "LATERAL_AUTH_PORT_SCAN",
      "name": "Lateral Auth Port Fan-out",
      "enabled": true,
      "severity": "High",
      "category": "discovery_lateral",
      "mitreTechnique": "T1046",
      "type": "network",
      "windowMinutes": 5,
      "minDistinctDestinations": 8,
      "authPorts": [22, 23, 135, 139, 445, 1433, 3306, 3389, 5985, 5986],
      "cooldownMinutes": 15,
      "description": "Rapid fan-out to many hosts on admin/auth ports from one process (prep for lateral movement)."
    }
  ]
}
