{
  "Kestrel": {
    "Port": 7443
  },
  "Security": {
    "EnableMtls": false
  },
  "Postgres": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=cherrysentinel;Username=cherrysentinel;Password=cherrysentinel"
  },
  "Correlation": {
    "TimestampToleranceSeconds": 120
  },
  "LoggingPaths": {
    "Directory": "logs"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
