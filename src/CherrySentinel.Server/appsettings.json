{
  "Kestrel": {
    "Port": 7443
  },
  "Security": {
    "EnableMtls": false
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Sqlite": {
    "DatabasePath": "C:\\ProgramData\\CherrySentinel\\Server\\central.db"
  },
  "Postgres": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=cherrysentinel;Username=cherrysentinel;Password=cherrysentinel"
  },
  "Syslog": {
    "Enabled": true,
    "UdpPort": 5514,
    "TcpPort": 0,
    "MatchOpenSourceSignatures": true,
    "SignaturesPath": "C:\\ProgramData\\CherrySentinel\\Server\\signatures\\opensource-signatures.json"
  },
  "Correlation": {
    "TimestampToleranceSeconds": 120
  },
  "LoggingPaths": {
    "Directory": "C:\\ProgramData\\CherrySentinel\\Server\\logs"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
