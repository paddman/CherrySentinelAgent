<Window x:Class="CherrySentinel.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cherry Sentinel Agent"
        Height="860" Width="1360"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="SidebarBg" Color="#0B1B33"/>
    <SolidColorBrush x:Key="SidebarActive" Color="#2563EB"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
    <SolidColorBrush x:Key="BorderLite" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Danger" Color="#EF4444"/>
    <SolidColorBrush x:Key="Ok" Color="#22C55E"/>
    <SolidColorBrush x:Key="Warn" Color="#F59E0B"/>

    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#152744"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavBtnActive" TargetType="Button" BasedOn="{StaticResource NavBtn}">
      <Setter Property="Background" Value="{StaticResource SidebarActive}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderLite}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" Color="#0F172A"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DBEAFE"/>
          <Setter Property="Foreground" Value="#0F172A"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="18" Background="#1D4ED8">
              <TextBlock Text="C" Foreground="White" FontWeight="Bold" FontSize="18"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Cherry Sentinel" Foreground="White" FontWeight="Bold" FontSize="14"/>
              <TextBlock Text="Agent Console" Foreground="#94A3B8" FontSize="11"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
          <Button x:Name="NavDashboard" Content="  Dashboard" Style="{StaticResource NavBtnActive}" Click="Nav_Click" Tag="Dashboard"/>
          <Button x:Name="NavIncidents" Content="  Incidents" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Incidents"/>
          <Button x:Name="NavPaths" Content="  Lateral Paths" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Paths"/>
          <Button x:Name="NavAgents" Content="  Endpoints" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Agents"/>
          <Button x:Name="NavCatalog" Content="  Detections / Rules" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Catalog"/>
          <Button x:Name="NavSettings" Content="  Settings" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Settings"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="14,0,14,18" Background="#12233F" CornerRadius="12" Padding="14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="SidebarStatusTitle" Text="Agent Status" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="SidebarStatusText" Text="Healthy" Foreground="#86EFAC" Margin="18,4,0,0"/>
            <TextBlock x:Name="SidebarCheckinText" Text="Last check-in: —" Foreground="#94A3B8" FontSize="11" Margin="18,2,0,0"/>
            <TextBlock Text="Version 1.0.0" Foreground="#64748B" FontSize="10" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border/>
      </DockPanel>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1" Margin="18,14,18,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Grid.Row="0" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
          <TextBlock x:Name="PageSubtitle" Text="Security overview · detect &amp; track" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#ECFDF5" CornerRadius="20" Padding="12,6" Margin="0,0,10,0" BorderBrush="#BBF7D0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="ProtectedBadge" Text="Protected" Foreground="#166534" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <TextBox x:Name="ServerUrlBox" Width="240" Text="https://localhost:7443" Padding="8,6" VerticalAlignment="Center"
                   BorderBrush="#CBD5E1" Background="White"/>
          <Button x:Name="RefreshBtn" Content="Refresh" Margin="8,0,0,0" Padding="14,7" Click="RefreshBtn_Click"
                  Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
          <Button x:Name="DemoBtn" Content="Load Demo" Margin="8,0,0,0" Padding="14,7" Click="DemoBtn_Click"
                  Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>
      </Grid>

      <!-- Pages -->
      <Grid Grid.Row="1">
        <!-- Dashboard overview -->
        <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <UniformGrid Columns="4" Margin="0,0,0,4">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Active Incidents" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                  <TextBlock x:Name="KpiIncidents" Text="0" FontSize="32" FontWeight="Bold" Foreground="#EF4444" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Threat Campaigns" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                  <TextBlock x:Name="KpiCampaigns" Text="0" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Multi-hop Paths" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                  <TextBlock x:Name="KpiMultiHop" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Endpoints / Agents" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                  <TextBlock x:Name="KpiAgents" Text="0" FontSize="32" FontWeight="Bold" Foreground="#22C55E" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Active Incidents" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                  <DataGrid x:Name="OverviewIncidentsGrid" HeadersVisibility="Column" MaxHeight="280"
                            SelectionChanged="IncidentsGrid_SelectionChanged">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                      <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
                      <DataGridTextColumn Header="Source → Dest" Binding="{Binding Route}" Width="180"/>
                      <DataGridTextColumn Header="Failed" Binding="{Binding FailedAttempts}" Width="60"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Incident Detail" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="IncidentDetailText" FontFamily="Consolas" FontSize="12"
                               Foreground="#334155" TextWrapping="Wrap" LineHeight="18"
                               Text="Select an incident"/>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Lateral Path Preview" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                <TextBlock x:Name="PathPreviewText" FontFamily="Consolas" FontSize="13" Foreground="#1D4ED8"
                           TextWrapping="Wrap" Text="No path loaded"/>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Incidents full -->
        <Grid x:Name="PageIncidents" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <DataGrid x:Name="IncidentsGrid" SelectionChanged="IncidentsGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Source" Binding="{Binding SourceIp}" Width="120"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding DestinationIp}" Width="120"/>
                <DataGridTextColumn Header="Port" Binding="{Binding DestinationPort}" Width="60"/>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="110"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                <DataGridTextColumn Header="Failed" Binding="{Binding FailedAttempts}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
            <ScrollViewer>
              <TextBlock x:Name="IncidentDetailText2" FontFamily="Consolas" FontSize="12"
                         Foreground="#334155" TextWrapping="Wrap" LineHeight="18"/>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- Paths -->
        <Grid x:Name="PagePaths" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.2*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Threat Campaigns" FontWeight="Bold" Margin="0,0,0,8"/>
              <ListBox x:Name="CampaignsList" BorderThickness="0" SelectionChanged="CampaignsList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Foreground="#64748B" FontSize="11">
                        <Run Text="Severity: "/><Run Text="{Binding Severity}"/>
                        <Run Text=" · Hops: "/><Run Text="{Binding HopCount}"/>
                      </TextBlock>
                      <TextBlock Text="{Binding PathSummary}" Foreground="#2563EB" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
            <ScrollViewer>
              <StackPanel>
                <TextBlock x:Name="PathVisualText" FontFamily="Consolas" FontSize="13" Foreground="#B45309"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock x:Name="CampaignDetailText" FontFamily="Consolas" FontSize="12"
                           Foreground="#334155" TextWrapping="Wrap" LineHeight="18"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- Agents -->
        <Border x:Name="PageAgents" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0">
          <DataGrid x:Name="AgentsGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Agent ID" Binding="{Binding AgentId}" Width="140"/>
              <DataGridTextColumn Header="Host" Binding="{Binding ComputerName}" Width="140"/>
              <DataGridTextColumn Header="IP" Binding="{Binding HostIp}" Width="120"/>
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
              <DataGridTextColumn Header="Last Seen (UTC)" Binding="{Binding LastSeenUtc, StringFormat=g}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Catalog -->
        <Border x:Name="PageCatalog" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0">
          <DataGrid x:Name="CatalogGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
              <DataGridTextColumn Header="Rule ID" Binding="{Binding DetectionRuleId}" Width="220"/>
              <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechnique}" Width="100"/>
              <DataGridTextColumn Header="Cross-host tracking" Binding="{Binding CrossHostTracking}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Settings -->
        <Border x:Name="PageSettings" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0">
          <StackPanel>
            <TextBlock Text="Connection Settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
            <TextBlock Text="Central Server URL" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
            <TextBox x:Name="SettingsUrlBox" Text="https://localhost:7443" Padding="10" Margin="0,0,0,12"/>
            <TextBlock x:Name="KpiMode" Text="Mode: —" Margin="0,0,0,6"/>
            <TextBlock x:Name="LastRefreshText" Text="" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Apply &amp; Refresh" Padding="16,8" Click="ApplySettings_Click"
                      Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
              <Button Content="Load Demo Data" Margin="10,0,0,0" Padding="16,8" Click="DemoBtn_Click"
                      Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Text="Icon &amp; branding assets: assets\icons\CherrySentinel.ico" Foreground="{StaticResource Muted}" Margin="0,24,0,0" FontSize="11"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
