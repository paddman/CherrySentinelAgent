<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CherrySentinel.Agent.Linux</RootNamespace>
    <AssemblyName>CherrySentinel.Agent.Linux</AssemblyName>
    <Description>Cherry Sentinel Linux Agent (systemd) — Phase 4 skeleton</Description>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CherrySentinel.Shared\CherrySentinel.Shared.csproj" />
    <ProjectReference Include="..\CherrySentinel.Transport\CherrySentinel.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="cherrysentinel-agent.service" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
