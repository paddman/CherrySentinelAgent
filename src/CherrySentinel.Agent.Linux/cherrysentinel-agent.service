[Unit]
Description=Cherry Sentinel Linux Agent
Documentation=https://github.com/paddman/CherrySentinelAgent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/cherrysentinel/agent/CherrySentinel.Agent.Linux
WorkingDirectory=/opt/cherrysentinel/agent
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
# Optional: Environment=CHERRY_Server__Url=https://10.0.0.5:7443
Environment=DOTNET_ENVIRONMENT=Production
# Allow writing logs if appsettings cannot update
ReadWritePaths=/opt/cherrysentinel /var/log/cherrysentinel
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
