CHERRY_ENVIRONMENT=development
CHERRY_HOST=0.0.0.0
CHERRY_PORT=8088
CHERRY_DATABASE_PATH=/data/sentinel-brain.db
CHERRY_PLAYBOOK_DIR=/app/playbooks

# Local Qwen through an OpenAI-compatible endpoint (vLLM/SGLang/Ollama gateway)
CHERRY_LLM_ENABLED=true
CHERRY_LLM_BASE_URL=http://host.docker.internal:8000/v1
CHERRY_LLM_API_KEY=local
CHERRY_LLM_MODEL=qwen3.5-9b
CHERRY_LLM_ENABLE_THINKING=false
CHERRY_ANALYSIS_MODE=multi_agent

# One or more tenant objects. Hash the key with SHA-256 and use api_key_sha256 in production.
# Cross-tenant IOC publication additionally requires metadata.can_publish_intel=true or an operator/SOC role.
CHERRY_TENANTS_JSON=[{"tenant_id":"demo","name":"Cherry Demo","api_key":"change-me","central_url":"https://host.docker.internal:7443","central_api_key":"replace-with-operator-key","central_verify_tls":false,"metadata":{"role":"operator","principal":"demo-soc","can_publish_intel":true}}]
CHERRY_ALLOW_DEV_TENANT=false

# Add the production dashboard origin at deployment time. Do not commit customer or live public IPs.
CHERRY_CORS_ORIGINS=http://203.0.113.10:10118
