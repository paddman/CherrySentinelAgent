CHERRY_PRODUCT_PROFILE=nt_shield
CHERRY_APP_NAME=NT Shield AI Incident Commander
CHERRY_ENVIRONMENT=development
CHERRY_HOST=0.0.0.0
CHERRY_PORT=8088
CHERRY_DATABASE_PATH=/data/nt-shield-brain.db
CHERRY_PLAYBOOK_DIR=/app/playbooks

# Approved local model through an OpenAI-compatible endpoint.
CHERRY_LLM_ENABLED=true
CHERRY_LLM_BASE_URL=http://host.docker.internal:8000/v1
CHERRY_LLM_API_KEY=local
CHERRY_LLM_MODEL=qwen3.5-9b
CHERRY_LLM_ENABLE_THINKING=false
CHERRY_ANALYSIS_MODE=multi_agent

# Demo only. Replace the key, Central URL and operator key before any shared pilot.
CHERRY_TENANTS_JSON=[{"tenant_id":"nt-demo","name":"NT Shield Demo","api_key":"change-me","central_url":"https://host.docker.internal:7443","central_api_key":"replace-with-operator-key","central_verify_tls":false,"metadata":{"role":"operator","principal":"nt-shield-demo","can_publish_intel":true}}]
CHERRY_ALLOW_DEV_TENANT=false
CHERRY_CORS_ORIGINS=
